{$CUPNAVI_STAGING_HOST:http://localhost:8080} {
    encode zstd gzip

    @api path /api/* /health
    reverse_proxy @api api:8001

    root * /srv/public_pwa
    try_files {path} {path}/ /index.html
    file_server

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        -Server
    }

    @service_worker path /service-worker.js
    header @service_worker Cache-Control "no-cache, no-store, must-revalidate"

    @manifest path /manifest.webmanifest
    header @manifest Content-Type application/manifest+json
}
