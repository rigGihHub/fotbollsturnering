# For a real HTTPS staging deployment, set a DNS name that resolves to the host.
CUPNAVI_STAGING_HOST=staging.example.com
CUPNAVI_PWA_ORIGINS=https://staging.example.com

TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=replace-me

# Optional host-side port overrides.
CUPNAVI_STAGING_HTTP_PORT=8080
CUPNAVI_STAGING_HTTPS_PORT=8443
